{
  "_displayName": "PBE DQ — IT-Ops Notification",
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {},
    "triggers": {
      "When_a_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "properties": {
              "run_id": {"type": "string"},
              "failures": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "rule_id":    {"type": "string"},
                    "rule_name":  {"type": "string"},
                    "rule_group": {"type": "string"},
                    "severity":   {"type": "string"},
                    "failed_rows":{"type": "integer"},
                    "status":     {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "actions": {
      "Parse_payload": {
        "type": "ParseJson",
        "runAfter": {},
        "inputs": {
          "content": "@triggerBody()",
          "schema": {
            "type": "object",
            "properties": {
              "run_id": {"type": "string"},
              "failures": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "rule_id":    {"type": "string"},
                    "rule_name":  {"type": "string"},
                    "rule_group": {"type": "string"},
                    "severity":   {"type": "string"},
                    "failed_rows":{"type": "integer"},
                    "status":     {"type": "string"}
                  }
                }
              }
            }
          }
        }
      },
      "Rename_columns": {
        "type": "Select",
        "runAfter": {"Parse_payload": ["Succeeded"]},
        "inputs": {
          "from": "@body('Parse_payload')?['failures']",
          "select": {
            "Regel-ID":    "@item()?['rule_id']",
            "Regelnavn":   "@item()?['rule_name']",
            "Katalog":     "@item()?['rule_group']",
            "Alvorlighet": "@item()?['severity']",
            "Antall feil": "@item()?['failed_rows']",
            "Status":      "@item()?['status']"
          }
        }
      },
      "Create_failures_table": {
        "type": "Table",
        "runAfter": {"Rename_columns": ["Succeeded"]},
        "inputs": {
          "format": "HTML",
          "from": "@body('Rename_columns')"
        }
      },
      "Send_IT_ops_email": {
        "type": "OpenApiConnection",
        "runAfter": {"Create_failures_table": ["Succeeded"]},
        "inputs": {
          "host": {
            "connectionName": "shared_office365",
            "operationId": "SendEmailV2",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
          },
          "parameters": {
            "emailMessage/To": "REPLACE_WITH_ITOPS_EMAIL",
            "emailMessage/Subject": "⚠️ PBE Datakvalitet — Systemfeil oppdaget [Run: @{body('Parse_payload')?['run_id']}]",
            "emailMessage/Body": "<h2 style=\"color:#c0392b\">Datakvalitetsfeil — Systemvarsling</h2><p>Kjøring <strong>@{body('Parse_payload')?['run_id']}</strong> rapporterte følgende regelbrudd som krever teknisk oppfølging:</p>@{body('Create_failures_table')}<p style=\"color:#888;font-size:12px\">Logg inn i Microsoft Fabric for å se detaljer i tabellen <em>dq_violations</em>.</p>",
            "emailMessage/Importance": "High",
            "emailMessage/IsHtml": true
          }
        }
      },
      "Respond_200": {
        "type": "Response",
        "kind": "Http",
        "runAfter": {"Send_IT_ops_email": ["Succeeded", "Failed"]},
        "inputs": {
          "statusCode": 200,
          "body": {"status": "ok"},
          "headers": {"Content-Type": "application/json"}
        }
      }
    },
    "outputs": {}
  },
  "connectionReferences": {
    "shared_office365": {
      "runtimeSource": "invoker",
      "connection": {},
      "api": {"name": "shared_office365"}
    }
  },
  "parameters": {}
}
